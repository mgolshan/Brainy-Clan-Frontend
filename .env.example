# Copy this file to .env (never commit .env).
#
# Use your Windows PC's LAN IP, NOT localhost: a phone running Expo Go on the same
# Wi-Fi resolves "localhost" to itself, so it could never reach the Docker backend.
# Find it with `ipconfig` -> "IPv4 Address" of your Wi-Fi/Ethernet adapter.

# Laravel backend (Brainy-Clan-Backend, Docker on the PC, port 8080).
EXPO_PUBLIC_API_URL=http://192.168.1.50:8080

# Only used by docker-compose.yml: the host Metro advertises in the QR code.
PC_LAN_IP=192.168.1.50

# Google and Facebook sign-in (README "Google and Facebook sign-in setup").
# Empty = buttons hidden. Restart Metro with --clear after changing; the iOS client ID and the
# Facebook app ID also need a new development build (native URL schemes).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Dev only: 1 = the social buttons return a fake token (testing against a mock backend).
# EXPO_PUBLIC_SOCIAL_FAKE=1

# Family plan purchases (README "Family plan purchases — RevenueCat setup"). Public SDK keys from
# RevenueCat → API keys. Empty = the paywall entry stays "coming soon". Only in dev/store builds.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Fallback legal links on the paywall when the backend has no `GET /legal` yet (hidden while empty).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Rewarded ads (README "Rewarded ads — AdMob setup"). App IDs are build-time (new build after a
# change); empty = Google's sample app IDs. Empty ad units = Google's test ads in development
# builds, no ads in release builds.
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=

# Error monitoring (README "Error monitoring — Sentry setup"). Empty DSN = Sentry off.
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only (EAS env vars): enable the source map upload plugin. The auth token is an EAS
# secret (SENTRY_AUTH_TOKEN) and never goes in this file or the repo.
SENTRY_ORG=
SENTRY_PROJECT=
