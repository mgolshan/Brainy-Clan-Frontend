{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.50:8080"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.brainyclan.com",
        "EXPO_PUBLIC_WEBSITE_URL": "https://brainyclan.com",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@brainyclan.com",
        "EXPO_PUBLIC_TERMS_URL": "https://brainyclan.com/terms",
        "EXPO_PUBLIC_PRIVACY_URL": "https://brainyclan.com/privacy"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.brainyclan.com",
        "EXPO_PUBLIC_WEBSITE_URL": "https://brainyclan.com",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@brainyclan.com",
        "EXPO_PUBLIC_TERMS_URL": "https://brainyclan.com/terms",
        "EXPO_PUBLIC_PRIVACY_URL": "https://brainyclan.com/privacy"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
